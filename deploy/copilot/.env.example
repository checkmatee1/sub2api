# Optional ordinary configuration. Source: choose an unused Mac mini loopback port.
# Change via editing .env while only the independent gateway is stopped.
COPILOT_GATEWAY_PORT=18991
# Optional ordinary configuration. Source: your GitHub Copilot subscription type.
# Allowed: individual, business, enterprise. Read/change here; never put tokens here.
COPILOT_ACCOUNT_TYPE=individual
# Required secret references (files, not environment variables):
# runtime/gateway.key: generated locally by manage.py init; never print or commit.
# runtime/auth/github_token: written locally by manage.py auth after device login.
# Read/modify through the management program; do not paste either secret into chat.
